{
  "name": "@rakhimgaliyev/react-bottom-sheet",
  "version": "2.0.0-rc.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "clean": "rm -rf dist",
    "build:js": "bun run scripts/build.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "bun run clean && bun run build:js && bun run build:types",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "prepublishOnly": "bun run build",
    "publish:npm": "npm publish --access public --tag next"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "react-jss": "^10.10.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/bun": "^1.3.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
  }
}
